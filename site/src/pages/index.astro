<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>keygloss: type ghbdtn, get привет</title>
<meta name="description" content="Keygloss fixes text typed in the wrong keyboard layout, RU ↔ EN. Free, open source, and it works on your computer only.">
<link rel="icon" href="img/icon.png">
<link rel="stylesheet" href="fonts/fonts.css">
<style is:inline>
:root{
  --kg-bg-from:#f3eee7;--kg-bg-to:#e4e5e3;--kg-text:#171819;--kg-accent:#8a6500;--kg-detail:#3d48b8;--kg-on-accent:#fffdf8;--kg-raised:#fbf9f5;
  --sky-top:color-mix(in oklab,var(--kg-accent) 85%,var(--kg-text));
  --sky-bot:color-mix(in oklab,var(--kg-accent) 26%,var(--kg-bg-to));
  --sky-ink:var(--kg-on-accent);
  --term-bg:var(--kg-text);--term-ink:var(--kg-bg-from);
  --hl:color-mix(in oklab,var(--kg-accent) 24%,var(--kg-raised));
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --kg-bg-from:#2b2d30;--kg-bg-to:#0b0c0d;--kg-text:#f3eee7;--kg-accent:#f5c84c;--kg-detail:#8e9bff;--kg-on-accent:#171819;--kg-raised:#34363a;
    --sky-top:color-mix(in oklab,var(--kg-accent) 18%,var(--kg-bg-to));
    --sky-bot:color-mix(in oklab,var(--kg-accent) 7%,var(--kg-bg-to));
    --sky-ink:var(--kg-text);
    --term-bg:var(--kg-bg-to);--term-ink:var(--kg-text);
    --hl:color-mix(in oklab,var(--kg-accent) 30%,var(--kg-raised));
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --kg-bg-from:#2b2d30;--kg-bg-to:#0b0c0d;--kg-text:#f3eee7;--kg-accent:#f5c84c;--kg-detail:#8e9bff;--kg-on-accent:#171819;--kg-raised:#34363a;
  --sky-top:color-mix(in oklab,var(--kg-accent) 18%,var(--kg-bg-to));
  --sky-bot:color-mix(in oklab,var(--kg-accent) 7%,var(--kg-bg-to));
  --sky-ink:var(--kg-text);
  --term-bg:var(--kg-bg-to);--term-ink:var(--kg-text);
  --hl:color-mix(in oklab,var(--kg-accent) 30%,var(--kg-raised));
  color-scheme:dark;
}
:root{
  --ink:var(--kg-text);
  --muted:color-mix(in oklab,var(--kg-text) 68%,var(--kg-bg-from));
  --faint:color-mix(in oklab,var(--kg-text) 58%,var(--kg-bg-from));
  --line:color-mix(in srgb,var(--kg-text) 13%,transparent);
  --line-2:color-mix(in srgb,var(--kg-text) 24%,transparent);
  --bar:color-mix(in oklab,var(--kg-text) 8%,var(--kg-raised));
  --panel:color-mix(in oklab,var(--kg-text) 4%,var(--kg-raised));
  --shadow:0 1px 2px color-mix(in srgb,var(--kg-text) 10%,transparent),0 10px 28px -10px color-mix(in srgb,var(--kg-text) 30%,transparent);
  --mono:ui-monospace,"Cascadia Mono",Consolas,monospace;
  --wrap:1090px;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:auto;-webkit-text-size-adjust:100%}
body{margin:0;font-family:"Libron",Georgia,serif;font-size:16px;line-height:1.5;color:var(--ink);
  background:linear-gradient(180deg,var(--kg-bg-from),var(--kg-bg-to)) fixed;overflow-x:hidden}
::selection{background:color-mix(in srgb,var(--kg-accent) 30%,transparent)}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
:focus-visible{outline:2px solid var(--kg-detail);outline-offset:2px;border-radius:4px}
h1,h2,h3,p,ul{margin:0;padding:0}
ul{list-style:none}
svg{display:block}
.ico{width:16px;height:16px;fill:currentColor;flex:none}
.wrap{width:min(var(--wrap),100% - 48px);margin-inline:auto}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
[hidden]{display:none!important}
code,.mono{font-family:var(--mono)}

/* ---------- menu bar ---------- */
.menubar{position:sticky;top:0;z-index:50;height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;
  background:color-mix(in srgb,var(--kg-bg-from) 92%,transparent);border-bottom:1px solid var(--line);font-size:14px}
.menubar nav ul{display:flex;gap:16px;align-items:center}
.menubar nav a{color:var(--muted)}
.menubar nav a:hover{color:var(--ink)}
.menubar nav a.brand{color:var(--ink);font-weight:700}
.status{display:flex;align-items:center;gap:4px;color:var(--muted)}
.status a,.status button{display:inline-flex;align-items:center;gap:5px;height:28px;padding:0 6px;border-radius:6px}
.status a:hover,.status button:hover{color:var(--ink);background:color-mix(in srgb,var(--kg-text) 7%,transparent)}
.status .ico{width:15px;height:15px}
.gh-pair{display:inline-flex;align-items:center}
.heart .ico{fill:var(--kg-accent)}
.theme{display:inline-flex;gap:1px}
.status .theme button{height:24px;padding:0 5px;opacity:.5}
.status .theme button[aria-pressed="true"]{opacity:1;background:color-mix(in srgb,var(--kg-text) 6%,transparent)}
.status .theme .ico{width:14px;height:14px}

.lang{position:relative}
.lang-btn{font-weight:700;font-size:12.5px;letter-spacing:.04em;border:1px solid var(--line-2);padding:0 7px!important;height:22px!important;border-radius:5px!important;color:var(--ink)}
.lang-list{position:absolute;right:0;top:34px;min-width:164px;padding:5px;background:var(--kg-raised);border:1px solid var(--line-2);border-radius:10px;box-shadow:var(--shadow)}
.lang-list li{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:6px;cursor:pointer;color:var(--ink);font-size:14.5px}
.lang-list li svg{width:22px;height:15px;border-radius:2px;box-shadow:0 0 0 1px var(--line-2);flex:none}
.lang-list li:hover,.lang-list li.active{background:color-mix(in srgb,var(--kg-text) 8%,transparent)}
.lang-list li[aria-selected="true"]::after{content:"";margin-left:auto;width:7px;height:7px;border-radius:50%;background:var(--kg-detail)}
.lang-list:focus-visible{outline:2px solid var(--kg-detail);outline-offset:2px;border-radius:10px}

/* ---------- windows ---------- */
.win{background:var(--kg-raised);border:1px solid var(--line-2);border-radius:9px;box-shadow:var(--shadow)}
.win-bar{height:26px;display:flex;align-items:center;gap:8px;padding:0 9px;background:var(--bar);border-bottom:1px solid var(--line);border-radius:8px 8px 0 0;font-size:11.5px;color:var(--faint);white-space:nowrap}
.dots{display:flex;gap:5px;flex:none}
.dots i{width:9px;height:9px;border-radius:50%;background:var(--kg-accent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--kg-text) 18%,transparent)}
.dots i:nth-child(2){background:color-mix(in oklab,var(--kg-accent) 45%,var(--kg-raised))}
.dots i:nth-child(3){background:color-mix(in oklab,var(--kg-detail) 70%,var(--kg-raised))}
.win-bar .t{flex:1;text-align:center;overflow:hidden;text-overflow:ellipsis;padding-right:36px}
.win-body{padding:5px}

/* rebuilt app UI */
.kgp{background:var(--panel);border:1px solid var(--line);border-radius:8px;font-size:12px;line-height:1.3}
.kgp .row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 10px;min-height:34px}
.kgp .row + .row{border-top:1px solid var(--line)}
.kgp .row > span:first-child{min-width:0}
.kgp .dim{opacity:.5}
.tg{flex:none;width:28px;height:16px;border-radius:99px;background:var(--kg-accent);position:relative}
.tg::after{content:"";position:absolute;right:2px;top:2px;width:12px;height:12px;border-radius:50%;background:var(--kg-on-accent)}
.tg.off{background:color-mix(in srgb,var(--kg-text) 26%,transparent)}
.tg.off::after{right:auto;left:2px;background:var(--kg-raised)}
.keys{display:inline-flex;align-items:center;gap:4px;flex:none;color:var(--faint);font-size:10px}
.kc{display:inline-block;padding:1px 6px;border:1px solid color-mix(in srgb,var(--kg-detail) 40%,transparent);border-bottom-width:2px;border-radius:5px;background:var(--kg-raised);color:var(--kg-detail);font-weight:700;font-size:11.5px;line-height:1.5}
.sel{display:inline-flex;align-items:center;gap:8px;padding:2px 8px;border:1px solid var(--line-2);border-radius:6px;background:var(--kg-raised);flex:none}
.sel::after{content:"";width:5px;height:5px;border-right:1.5px solid var(--muted);border-bottom:1.5px solid var(--muted);transform:rotate(45deg);margin-top:-3px}
.hist .when{font-size:10px;font-weight:700;color:var(--faint)}
.hist .from{color:var(--faint)}
.hist .to{font-weight:700}
.hist .arrow{color:var(--faint);margin:0 4px}
.never{display:inline-flex;align-items:center;gap:4px;margin-top:5px;padding:2px 7px;border:1px solid var(--line-2);border-radius:5px;font-size:10.5px;color:var(--muted)}
.never svg{width:10px;height:10px;fill:none;stroke:currentColor;stroke-width:2}

/* image crops: unitless image px in --cx/--cy/--cw/--ch, scale in --s */
.crop{display:block;flex:none;width:calc(var(--cw) * var(--s) * 1px);height:calc(var(--ch) * var(--s) * 1px);
  background-repeat:no-repeat;background-size:calc(2400px * var(--s)) auto;
  background-position:calc(var(--cx) * var(--s) * -1px) calc(var(--cy) * var(--s) * -1px);border-radius:6px;max-width:100%}
.crop.lay{background-image:url(img/layout-switching.webp)}
.crop.snp{background-image:url(img/snippets.webp)}
html[lang="ru"] .crop.lay{background-image:url(img/layout-switching-ru.webp)}
html[lang="ru"] .crop.snp{background-image:url(img/snippets-ru.webp)}
.crop.chips{--cx:1418;--cy:1368;--cw:574;--ch:94}
html[lang="ru"] .crop.chips{--cx:1390;--cy:1360;--cw:602}
.crop.hot{--cx:1680;--cy:988;--cw:306;--ch:92}
html[lang="ru"] .crop.hot{--cy:980}
.crop.trig{--cx:842;--cy:1302;--cw:1174;--ch:258}
html[lang="ru"] .crop.trig{--cy:1293}
.crop.ex{--cx:846;--cy:846;--cw:640;--ch:174}
.crop.greet{--cx:843;--cy:1582;--cw:1170;--ch:306}
.crop.sc{--cx:1588;--cy:1456;--cw:394;--ch:86}

/* ---------- hero ---------- */
.hero{position:relative;overflow:hidden;padding:150px 0 0;text-align:center;
  background-image:radial-gradient(color-mix(in srgb,var(--kg-text) 16%,transparent) 1px,transparent 1.4px);background-size:43px 43px;background-position:50% 16px}
.hero-core{position:relative;z-index:2}
h1{font-size:88px;line-height:1.1;font-weight:700;letter-spacing:-.03em}
.tagline{font-size:19px;margin-top:6px}
.ctas{display:flex;justify-content:center;gap:20px;margin-top:34px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:11px;height:40px;padding:0 20px;border-radius:99px;font-size:17px;white-space:nowrap;
  border:1px solid var(--line-2);background:linear-gradient(180deg,var(--kg-raised),color-mix(in oklab,var(--kg-text) 7%,var(--kg-raised)));
  box-shadow:inset 0 1px 0 color-mix(in srgb,var(--kg-on-accent) 50%,transparent),0 1px 2px color-mix(in srgb,var(--kg-text) 14%,transparent),0 6px 14px -8px color-mix(in srgb,var(--kg-text) 40%,transparent)}
.pill:hover{background:var(--kg-raised)}
.pill .ico{width:17px;height:17px}
.pill.primary{color:var(--kg-on-accent);border-color:color-mix(in oklab,var(--kg-accent) 70%,var(--kg-text));
  background:linear-gradient(180deg,color-mix(in oklab,var(--kg-accent) 88%,var(--kg-on-accent)),var(--kg-accent));
  box-shadow:inset 0 1px 0 color-mix(in srgb,var(--kg-on-accent) 35%,transparent),0 1px 2px color-mix(in srgb,var(--kg-text) 20%,transparent),0 8px 16px -8px color-mix(in srgb,var(--kg-accent) 70%,transparent)}
.pill.primary:hover{background:var(--kg-accent)}
.pill.sm{height:36px;font-size:16px;padding:0 18px}
.under{font-size:12.5px;color:var(--faint);margin-top:14px}
.neutral{font-size:13.5px;color:var(--muted);margin-top:10px}

.collage{position:absolute;inset:0;z-index:1;transform-origin:50% 0}
.c{position:absolute;left:calc(50% + (var(--x) - 720) * 1px);top:calc(var(--y) * 1px);text-align:left}
.keycap{width:46px;height:46px;border-radius:9px;position:relative;font-weight:700;
  background:linear-gradient(180deg,var(--kg-raised),color-mix(in oklab,var(--kg-text) 6%,var(--kg-raised)));
  border:1px solid var(--line-2);border-bottom-width:4px;box-shadow:0 6px 12px -6px color-mix(in srgb,var(--kg-text) 40%,transparent)}
.keycap b{position:absolute;left:8px;top:3px;font-size:15px}
.keycap i{position:absolute;right:8px;bottom:2px;font-style:normal;font-size:15px;color:var(--kg-accent)}
.keycap.wide{width:auto;height:40px;padding:0 14px;display:inline-grid;place-items:center;font-size:15px;color:var(--kg-detail)}
.sticky{width:118px;padding:12px 10px 16px;background:var(--hl);color:var(--ink);font-size:17px;line-height:1.25;text-align:center;
  box-shadow:0 1px 1px color-mix(in srgb,var(--kg-text) 20%,transparent),0 12px 16px -10px color-mix(in srgb,var(--kg-text) 45%,transparent);transform:rotate(-5deg)}
.sticky s{color:var(--muted);text-decoration-thickness:1px}
.sticky b{display:block;font-size:21px}
.tag{width:78px;border-radius:5px;overflow:hidden;background:var(--kg-raised);text-align:center;transform:rotate(4deg);
  box-shadow:0 1px 1px color-mix(in srgb,var(--kg-text) 20%,transparent),0 8px 12px -8px color-mix(in srgb,var(--kg-text) 45%,transparent)}
.tag::before,.tag::after{content:"";display:block;height:11px;background:var(--kg-accent)}
.tag::after{height:5px}
.tag span{display:block;padding:7px 0 6px;font-weight:700;font-size:14px;line-height:1}
.stk{padding:8px 11px 10px;background:var(--kg-raised);border:1px solid var(--line-2);border-radius:10px;box-shadow:var(--shadow);font-size:12px;line-height:1.35;white-space:nowrap}
.stk-h{display:block;font-size:10.5px;color:var(--faint);margin-bottom:6px;white-space:nowrap}
.stk .row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:5px 0}
.stk .row + .row{border-top:1px solid var(--line)}
.stk .arrow{color:var(--faint);margin:0 5px}
.stk .keys{font-size:12px}.stk .kc{font-size:13px;padding:1px 8px}
.stk .never{display:flex;width:max-content}
.photo{padding:4px;background:var(--kg-raised);border-radius:8px;box-shadow:var(--shadow);border:1px solid var(--line)}
.mini{display:none}

.demo{position:relative;z-index:2;width:min(800px,100% - 48px);margin:56px auto 0;text-align:left;border-radius:14px}
.demo .win-bar{border-radius:13px 13px 0 0;height:30px}
.demo-body{height:408px;border-radius:0 0 13px 13px;padding:44px 56px;display:flex;flex-direction:column;
  background:linear-gradient(165deg,color-mix(in oklab,var(--kg-accent) 12%,var(--kg-raised)),var(--kg-raised) 55%,color-mix(in oklab,var(--kg-detail) 9%,var(--kg-raised)))}
.demo-label{font-size:13px;color:var(--faint);margin-bottom:4px}
.typed{font-size:40px;line-height:1.15;color:var(--faint);text-decoration:line-through;text-decoration-thickness:2px;text-decoration-color:color-mix(in srgb,var(--kg-accent) 70%,transparent)}
.fixed{font-size:72px;line-height:1.1;font-weight:700;letter-spacing:-.02em;margin-bottom:auto}
.fixed .caret{display:inline-block;width:3px;height:.9em;background:var(--kg-accent);vertical-align:-.08em;margin-left:6px}
.demo-status{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:14px;color:var(--muted);border-top:1px solid var(--line);padding-top:16px}
.badge{display:inline-flex;align-items:center;gap:7px;padding:2px 10px;border-radius:99px;border:1px solid color-mix(in srgb,var(--kg-detail) 40%,transparent);color:var(--kg-detail);font-weight:700;font-size:13px;background:var(--kg-raised)}
.badge::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--kg-detail)}

/* ---------- feature rows ---------- */
.rows{padding:96px 0 0;display:grid;gap:80px}
.frow{display:grid;grid-template-columns:5fr 7fr;gap:56px;align-items:center}
.frow.flip{grid-template-columns:7fr 5fr}
.frow.flip .ftext{order:2}
.ftext{display:flex;flex-direction:column;align-items:flex-start}
.ftext .seq{margin-bottom:18px}.ftext .bubble{margin-bottom:26px}
.seq{display:flex;gap:5px;align-items:center}
.seq i{width:13px;height:13px;border-radius:3px;border:1px solid var(--line-2);border-bottom-width:2px;background:var(--kg-raised)}
.seq i.on{background:var(--kg-accent);border-color:color-mix(in oklab,var(--kg-accent) 70%,var(--kg-text))}
.seq i.sp{width:38px}
.bubble{display:inline-flex;align-items:center;gap:8px;padding:8px 20px;border-radius:22px;font-size:23px;line-height:1.3;position:relative;white-space:nowrap;
  background:linear-gradient(180deg,var(--kg-raised),var(--hl));border:1px solid color-mix(in oklab,var(--kg-accent) 55%,var(--kg-raised));
  box-shadow:inset 0 1px 0 color-mix(in srgb,var(--kg-on-accent) 60%,transparent),0 8px 14px -8px color-mix(in srgb,var(--kg-text) 40%,transparent)}
.bubble s{color:var(--muted);text-decoration-thickness:1px}
.bubble .kc{font-size:17px;padding:1px 9px}
.ftext h3{font-size:24px;text-wrap:balance;font-weight:700;line-height:1.3;margin-bottom:10px}
.ftext p{color:var(--muted);max-width:40ch}
.fwin{border-radius:14px;overflow:hidden}
.fwin .win-bar{height:30px;border-radius:0}
.wall{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:36px 32px;
  background:linear-gradient(150deg,color-mix(in oklab,var(--kg-accent) 34%,var(--kg-raised)),color-mix(in oklab,var(--kg-accent) 10%,var(--kg-raised)) 48%,color-mix(in oklab,var(--kg-detail) 20%,var(--kg-raised)))}
.wall.b{background:linear-gradient(210deg,color-mix(in oklab,var(--kg-detail) 22%,var(--kg-raised)),color-mix(in oklab,var(--kg-accent) 12%,var(--kg-raised)) 55%,color-mix(in oklab,var(--kg-accent) 36%,var(--kg-raised)))}
.wall.c2{background:linear-gradient(180deg,color-mix(in oklab,var(--kg-text) 16%,var(--kg-raised)),color-mix(in oklab,var(--kg-accent) 26%,var(--kg-raised)))}
.wall .inner{width:100%;max-width:520px}
.wall .kgp{font-size:15px;border-radius:12px;box-shadow:var(--shadow);background:var(--kg-raised)}
.wall .kgp .row{padding:12px 16px;min-height:48px}
.wall .tg{width:38px;height:22px}.wall .tg::after{width:16px;height:16px;top:3px;right:3px}
.wall .kc{font-size:14px;padding:2px 8px}
.wall .sel{padding:4px 10px}
.wall .crop{box-shadow:var(--shadow);border-radius:10px}
.wall .pair{display:flex;gap:16px;align-items:flex-start;justify-content:center;flex-wrap:wrap}
[data-theme="dark"] .crop.lay{filter:brightness(.88)}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .crop.lay{filter:brightness(.88)}}
.tilt-l{transform:rotate(-2deg)}.tilt-r{transform:rotate(2deg)}

/* ---------- section heads ---------- */
.eyebrow{display:inline-block;padding:4px 12px;border:1px solid var(--line-2);border-radius:99px;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.center{text-align:center}
h2{font-size:56px;line-height:1.2;font-weight:700;letter-spacing:-.03em;text-wrap:balance}

/* ---------- privacy (notes) ---------- */
.privacy{position:relative;padding:96px 0;overflow:hidden}
.notes{position:relative;z-index:2;width:min(480px,100% - 48px);margin:24px auto 0;border-radius:8px}
.notes .win-bar{background:var(--hl);height:30px}
.notes-body{padding:22px 24px 44px;font-size:19px;line-height:30px;color:var(--muted)}
.notes-body p + p{margin-top:10px}
.notes-body mark{background:var(--hl);color:var(--ink);padding:3px 2px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.notes-body .caret{display:inline-block;width:1px;height:22px;background:var(--ink);vertical-align:-4px;margin-left:2px}
.sig{display:flex;align-items:center;gap:12px;margin-top:38px;font-size:16px;line-height:24px}
.sig img{width:40px;height:40px;border-radius:50%}
.sig strong{display:block;color:var(--ink);font-weight:400}
.sig .hand{margin-left:auto;font-style:italic;font-weight:700;font-size:34px;color:var(--ink);transform:rotate(-6deg);letter-spacing:-.02em;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
.arc{position:absolute;top:0;left:50%;width:0;height:0;z-index:1}
.arc i{position:absolute;width:74px;height:62px;border-radius:10px 10px 8px 8px;font-style:normal;font-weight:700;font-size:17px;padding:4px 0 0 10px;
  border:1px solid color-mix(in srgb,var(--kg-text) 16%,transparent);border-bottom-width:5px;color:color-mix(in srgb,var(--kg-text) 70%,transparent)}
.rule{border:0;border-top:1px dotted var(--line-2);margin:0 auto}

/* ---------- install (sky) ---------- */
.install{position:relative;border-radius:40px;padding:64px 0 34px;color:var(--ink);
  background:
    radial-gradient(420px 150px at 12% 9%,color-mix(in srgb,var(--kg-on-accent) 16%,transparent),transparent 70%),
    radial-gradient(520px 170px at 84% 16%,color-mix(in srgb,var(--kg-on-accent) 13%,transparent),transparent 70%),
    radial-gradient(600px 200px at 30% 44%,color-mix(in srgb,var(--kg-on-accent) 10%,transparent),transparent 70%),
    radial-gradient(520px 190px at 88% 62%,color-mix(in srgb,var(--kg-on-accent) 12%,transparent),transparent 70%),
    var(--sky-top)}
.install .head{color:var(--sky-ink)}
.install .eyebrow{background:var(--kg-raised);color:var(--muted);border-color:transparent}
.seg{display:inline-flex;gap:2px;padding:4px;border-radius:99px;background:color-mix(in srgb,var(--kg-raised) 30%,transparent);border:1px solid color-mix(in srgb,var(--sky-ink) 35%,transparent)}
.seg button{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 18px;border-radius:99px;font-size:17px;color:var(--sky-ink)}
.seg button[aria-selected="true"]{background:var(--kg-raised);color:var(--ink);box-shadow:0 1px 3px color-mix(in srgb,var(--kg-text) 30%,transparent)}
.seg button:focus-visible{outline-color:var(--sky-ink);border-radius:99px}
.install .neutral{color:var(--sky-ink);margin-top:14px}
.get-row{display:flex;justify-content:center;align-items:center;gap:16px;margin-top:40px}
.term{position:relative;flex:0 1 auto;min-width:0;border-radius:9px;background:var(--term-bg);color:var(--term-ink);border:1px solid color-mix(in srgb,var(--term-ink) 22%,transparent);box-shadow:var(--shadow)}
.term-body{display:flex;align-items:center;gap:16px;padding:10px 10px 10px 16px}
.cmd{display:block;font-family:var(--mono);font-size:14.5px;line-height:1.4;overflow-x:auto;white-space:nowrap;padding-bottom:2px}
.cmd::before{content:"$ ";color:color-mix(in srgb,var(--term-ink) 60%,transparent)}
.term :focus-visible{outline-color:var(--term-ink)}
.term.wrap .cmd{white-space:normal;word-break:break-all}
.term .pill{color:var(--kg-text);flex:none;gap:7px;height:32px;padding:0 14px;font-size:14px}
:root[data-theme="dark"] .term .pill{color:var(--kg-text)}
.term .pill.done{background:var(--kg-accent);color:var(--kg-on-accent);border-color:transparent}
.foot{font-size:12.5px;color:var(--muted);margin:14px auto 0;max-width:640px;text-align:center}
.install .rule{margin-top:14px}
.install .foot{color:color-mix(in srgb,var(--sky-ink) 88%,transparent)}
.install .foot a{text-decoration:underline;text-underline-offset:3px}

/* ---------- faq ---------- */
.faq{padding:96px 0;position:relative}
.faq h2.eyebrow{font-size:22px;line-height:1.3;font-weight:400;letter-spacing:.06em;padding:8px 24px}
.qa{width:min(834px,100%);margin:32px auto 0;display:grid;gap:8px}
.qa details{background:var(--kg-raised);border-radius:6px;box-shadow:0 1px 2px color-mix(in srgb,var(--kg-text) 8%,transparent)}
.qa summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:60px;padding:12px 20px;font-size:19px;cursor:pointer;list-style:none}
.qa summary::-webkit-details-marker{display:none}
.qa summary::after{content:"";width:14px;height:14px;flex:none;margin-right:4px;
  background:linear-gradient(var(--ink),var(--ink)) 50%/100% 1.5px no-repeat,linear-gradient(var(--ink),var(--ink)) 50%/1.5px 100% no-repeat}
.qa details[open] summary::after{transform:rotate(45deg)}
.qa details[open] summary{padding-bottom:2px;min-height:48px;align-items:flex-end}
.qa details p{padding:0 20px 18px;color:var(--muted);max-width:510px;box-sizing:content-box}
.qa details a{color:var(--kg-detail);text-decoration:underline;text-underline-offset:3px}
.faq .photo{position:absolute;right:calc(50% - 622px);top:296px;transform:rotate(6deg)}

/* ---------- footer ---------- */
footer{padding:8px 0 28px}
.flinks{display:flex;justify-content:center;flex-wrap:wrap;gap:4px 28px;font-size:15px;color:var(--muted)}
.flinks ul{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 20px}
.flinks ul + ul{padding-left:28px;border-left:1px solid var(--line)}
.flinks li{display:flex;align-items:center;gap:6px}
.flinks a{display:inline-flex;align-items:center;gap:7px;min-height:32px}
.flinks a:hover{color:var(--ink)}
.flinks .ico{width:15px;height:15px}
.pix-wrap{width:min(640px,100%);margin:40px auto 0}
.pix{--cell:calc(min(100vw - 48px,640px) / 47);display:grid;grid-template-columns:repeat(47,var(--cell));grid-auto-rows:var(--cell)}
.pix i{margin:1px;border-radius:22%;background:linear-gradient(180deg,color-mix(in oklab,var(--kg-accent) 62%,var(--kg-raised)),var(--kg-accent));
  border-bottom:2px solid color-mix(in oklab,var(--kg-accent) 72%,var(--kg-text))}
.copy{text-align:center;font-size:12.5px;color:var(--faint);margin-top:32px;text-wrap:balance}
.copy a{text-decoration:underline;text-underline-offset:3px}

/* ---------- responsive ---------- */
@media (max-width:1399px){.collage{transform:scale(.86)}.faq .photo{right:16px}}
@media (max-width:1239px){.collage{transform:scale(.74)}
  .frow{gap:40px}
  .faq .photo{display:none}}
@media (max-width:999px){
  .collage{display:none}
  .mini{display:flex;justify-content:center;align-items:center;gap:14px;position:relative;z-index:2}
  .mini.top{margin-bottom:34px}.mini.bot{margin-top:30px;gap:18px}
  .hero{padding-top:36px}
  .menubar nav li:not(:first-child){display:none}
  .rows{padding-top:64px;gap:64px}
  .frow,.frow.flip{grid-template-columns:1fr;gap:28px}
  .frow.flip .ftext{order:0}
  .arc{display:none}
  .privacy{padding:64px 0}
  .flinks ul + ul{padding-left:0;border-left:0}
  .faq{padding:64px 0}
}
@media (max-width:640px){
  h1{font-size:64px}
  h2{font-size:38px}
  .menubar{padding:0 12px}.status{gap:0}
  .tagline{font-size:17.5px;padding:0 20px;text-wrap:balance}
  .ctas{flex-direction:column;align-items:center;gap:12px}
  .demo-body{height:auto;padding:26px 22px 20px;gap:4px}
  .typed{font-size:24px}.fixed{font-size:40px;margin-bottom:38px}
  .wall{padding:18px 12px}
  .wall .kgp{font-size:13.5px}.wall .kgp .row{padding:10px 12px}
  .wall .crop{--s:.262!important}
  .under,.hero-core>p{padding-inline:20px;text-wrap:balance}
  .bubble{font-size:20px}
  .install{padding-top:44px;border-radius:20px}
  .seg button{padding:0 14px;font-size:16px}
  .get-row{flex-direction:column;align-items:stretch}.get-row .pill.primary{justify-content:center}
  .cmd{font-size:13px}
  .notes-body{font-size:17px;line-height:27px;padding:18px 18px 30px}
  .sig .hand{font-size:26px}
  .qa summary{font-size:17px;padding:10px 14px}.qa details p{padding:0 14px 16px}
  .pix i{border-bottom-width:1px}
}
</style>
