    $('#cmd').textContent=CMD[os];
    $('#term').classList.toggle('wrap',os==='linux');
    $('#osNote').innerHTML=L.note[os]; $('#osNote').hidden=!L.note[os];
    $('#dlLinkT').textContent=L.dl[os];
    $$('[data-copy-label]').forEach(function(el){el.textContent=L.copy});
    $$('[data-copy]').forEach(function(b){b.classList.remove('done')});
    renderStars();
  }
  function renderStars(){
    var ok=typeof stars==='number'&&isFinite(stars)&&stars>=0, n=ok?stars.toLocaleString(lang==='ru'?'ru-RU':'en-US'):'';
    var label=ok?OS[lang].stars(stars).replace(String(stars),n):'';
    $$('[data-stars]').forEach(function(a){a.hidden=!ok; a.textContent=ok?'★ '+n:''; if(ok)a.setAttribute('aria-label',label)});
    $$('[data-stars-star]').forEach(function(a){a.hidden=!ok; a.textContent=ok?'★ '+n:''; if(ok)a.setAttribute('aria-label',label)});
  }
  function setOS(v){os=v; render()}
  $$('.seg button').forEach(function(b,i,all){
    b.addEventListener('click',function(){setOS(b.getAttribute('data-os'))});
    b.addEventListener('keydown',function(e){
      if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault(); var t=all[(i+(e.key==='ArrowRight'?1:all.length-1))%all.length]; setOS(t.getAttribute('data-os')); t.focus()}
    });
  });

  /* ---------- copy ---------- */
  $$('[data-copy]').forEach(function(btn){
    btn.addEventListener('click',function(){
      var text=CMD[os], done=function(){
        btn.classList.add('done'); $('[data-copy-label]',btn).textContent=OS[lang].copied;
        clearTimeout(btn._t); btn._t=setTimeout(function(){btn.classList.remove('done'); $('[data-copy-label]',btn).textContent=OS[lang].copy},1800);
      };
      var fallback=function(){var ta=document.createElement('textarea'); ta.value=text; ta.style.position='fixed'; ta.style.opacity='0'; document.body.appendChild(ta); ta.select(); try{document.execCommand('copy'); done()}catch(e){} ta.remove()};
      if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done,fallback); else fallback();
    });
  });

  /* ---------- theme ---------- */
  var dark=matchMedia('(prefers-color-scheme: dark)');
  function markTheme(){var t=root.getAttribute('data-theme')||(dark.matches?'dark':'light'); $$('[data-theme-set]').forEach(function(b){b.setAttribute('aria-pressed',String(b.getAttribute('data-theme-set')===t))})}
  $$('[data-theme-set]').forEach(function(b){b.addEventListener('click',function(){var t=b.getAttribute('data-theme-set'); root.setAttribute('data-theme',t); store('kg-theme',t); markTheme()})});
  dark.addEventListener('change',markTheme); markTheme();

  /* ---------- language picker ---------- */
  var btn=$('#langBtn'), list=$('#langList'), opts=$$('li',list), active=0;
  function mark(i){active=(i+opts.length)%opts.length; opts.forEach(function(o,j){o.classList.toggle('active',j===active)}); list.setAttribute('aria-activedescendant',opts[active].id)}
  function openL(){list.hidden=false; btn.setAttribute('aria-expanded','true'); mark(Math.max(0,opts.findIndex(function(o){return o.getAttribute('data-lang')===lang}))); list.focus()}
  function closeL(focus){list.hidden=true; btn.setAttribute('aria-expanded','false'); if(focus)btn.focus()}
  function setLang(v,save){lang=v==='ru'?'ru':'en'; if(save)store('kg-lang',lang); render()}
  btn.addEventListener('click',function(){list.hidden?openL():closeL()});
  btn.addEventListener('keydown',function(e){if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault(); openL()}});
  list.addEventListener('keydown',function(e){
    if(e.key==='ArrowDown'){e.preventDefault(); mark(active+1)}
    else if(e.key==='ArrowUp'){e.preventDefault(); mark(active-1)}
    else if(e.key==='Home'){e.preventDefault(); mark(0)}
    else if(e.key==='End'){e.preventDefault(); mark(opts.length-1)}
    else if(e.key==='Enter'||e.key===' '){e.preventDefault(); setLang(opts[active].getAttribute('data-lang'),true); closeL(true)}
    else if(e.key==='Escape'){e.preventDefault(); closeL(true)}
    else if(e.key==='Tab'){closeL()}
  });
  opts.forEach(function(o,i){o.addEventListener('click',function(){setLang(o.getAttribute('data-lang'),true); closeL(true)}); o.addEventListener('mousemove',function(){mark(i)})});
  document.addEventListener('click',function(e){if(!list.hidden&&!e.target.closest('.lang'))closeL()});

  /* ---------- decorative keycaps ---------- */
  function arc(el,pts,letters,n,mix){
    var segs=[],total=0,i;
    for(i=1;i<pts.length;i++){var d=Math.hypot(pts[i][0]-pts[i-1][0],pts[i][1]-pts[i-1][1]); segs.push(d); total+=d}
    for(i=0;i<n;i++){
      var t=i/(n-1)*total,s=0; while(s<segs.length-1&&t>segs[s]){t-=segs[s];s++}
      var f=t/segs[s],x=pts[s][0]+(pts[s+1][0]-pts[s][0])*f,y=pts[s][1]+(pts[s+1][1]-pts[s][1])*f,k=document.createElement('i'),p=i/(n-1);
      k.textContent=letters[i%letters.length];
      k.style.cssText='left:'+x.toFixed(0)+'px;top:'+y.toFixed(0)+'px;background:'+(i%4===3?mix(p):'var(--kg-raised)')+';opacity:'+Math.min(1,.12+p*2.6).toFixed(2);
      el.appendChild(k);
    }
  }
  arc($('#arcL'),[[-760,290],[-600,640],[-545,655],[-420,310],[-300,262],[-236,262]],['g','h','b','d','t','n'],30,function(p){
    return 'color-mix(in oklab,var(--kg-accent) '+Math.round(18+p*62)+'%,color-mix(in oklab,var(--kg-detail) '+Math.round(40-p*40)+'%,var(--kg-raised)))'});
  arc($('#arcR'),[[730,330],[600,640],[560,640],[440,300],[300,262],[166,262]],['п','р','и','в','е','т'],30,function(p){
    return 'color-mix(in oklab,var(--kg-accent) '+Math.round(10+p*45)+'%,color-mix(in oklab,var(--kg-text) '+Math.round(26-p*20)+'%,var(--kg-raised)))'});

  var F={k:['X....','X....','X..X.','X.X..','XX...','X.X..','X..X.','.....','.....'],
         e:['.....','.....','.XXX.','X...X','XXXXX','X....','.XXXX','.....','.....'],
         y:['.....','.....','X...X','X...X','X...X','.XXXX','....X','....X','.XXX.'],
         g:['.....','.....','.XXXX','X...X','X...X','.XXXX','....X','....X','.XXX.'],
         l:['XX...','.X...','.X...','.X...','.X...','.X...','.X...','.....','.....'],
         o:['.....','.....','.XXX.','X...X','X...X','X...X','.XXX.','.....','.....'],
         s:['.....','.....','.XXXX','X....','.XXX.','....X','XXXX.','.....','.....']};
  var pix=$('#pix'), word='keygloss'.split('');
  for(var r=0;r<9;r++) word.forEach(function(ch,ci){
    for(var c=0;c<5;c++) if(F[ch][r][c]==='X'){var d=document.createElement('i'); d.style.gridColumn=String(ci*6+c+1); d.style.gridRow=String(r+1); pix.appendChild(d)}
  });

  /* ---------- start ---------- */
  var ql=qs.get('lang'), saved=store('kg-lang');
  lang=(ql==='ru'||ql==='en')?ql:(saved==='ru'||saved==='en')?saved:(/^ru/i.test(navigator.language||'')?'ru':'en');
  render();
  if(document.fonts&&document.fonts.ready) document.fonts.ready.then(render);
  window.addEventListener('resize',render);

  var fake=qs.get('stars');
  if(fake==='off'){/* screenshot the no-number state */}
  else if(fake&&/^\d+$/.test(fake)){stars=parseInt(fake,10); renderStars()}
  else fetch('https://api.github.com/repos/xArchange1/keygloss',{headers:{Accept:'application/vnd.github+json'}})
    .then(function(r){return r.ok?r.json():null})
    .then(function(d){if(d&&Number.isInteger(d.stargazers_count)){stars=d.stargazers_count; renderStars()}})
    .catch(function(){});
})();
</script>
</body>
</html>
